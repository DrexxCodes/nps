{
  "name": "nps",
  "version": "0.1.0",
  "private": true,
  "description": "NPS (NAPSS Payment Suite) - NAPSS, UNIZIK. Developed by Drexx Technologies.",
  "scripts": {
    "dev": "next dev -p 2005",
    "build": "next build",
    "start": "next start -p 2005",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bootstrap:super-admin": "node --env-file=.env.local scripts/bootstrap-super-admin.mjs",
    "backfill:dars": "node --env-file=.env.local scripts/backfill-dars-fields.mjs",
    "backfill:sales": "node --env-file=.env.local scripts/backfill-sales-stats.mjs",
    "backfill:wallets": "node --env-file=.env.local scripts/backfill-item-wallets.mjs",
    "payment": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/payment.ts",
    "app": "pnpm run build && pnpm run start"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.900.0",
    "@dicebear/core": "^9.4.3",
    "@dicebear/lorelei": "^9.4.2",
    "@hookform/resolvers": "^5.2.0",
    "@react-pdf/renderer": "^4.3.0",
    "@some19ice/nigeria-geo-core": "^0.1.4",
    "firebase": "^12.4.0",
    "firebase-admin": "^13.5.0",
    "lenis": "^1.3.11",
    "lucide-react": "^0.545.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
